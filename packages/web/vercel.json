{
  "framework": "vite",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}